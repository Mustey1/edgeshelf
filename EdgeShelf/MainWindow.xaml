<Window x:Class="EdgeShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeShelf"
        Title="Edge Shelf" Width="32" Height="160" MinWidth="32" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" AllowDrop="True"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#788B9BAD"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B2AFC0CF"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#FF9EC3E3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VerticalScrollThumb" TargetType="Thumb" BasedOn="{StaticResource ScrollThumb}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="4" HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalScrollThumb" TargetType="Thumb" BasedOn="{StaticResource ScrollThumb}">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Height="4" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,4,1,4">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollTrackButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VerticalScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollTrackButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Maximum" Value="0">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="4,1,4,1">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollTrackButton}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource HorizontalScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollTrackButton}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="CardListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" CornerRadius="8">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSurface" TargetType="Border">
            <Setter Property="Background" Value="#FF252C36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#FF303B4B"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF303B4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Foreground" Value="#FFB4BFCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF303B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIconStroke" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="ClipboardIconStroke" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Stroke" Value="#FFB8CBE0"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="CardDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#FFB8C4D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#33E98B8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFA1A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShelfDeleteButton" TargetType="Button" BasedOn="{StaticResource CardDeleteButton}">
            <Setter Property="ToolTip" Value="Remove from Shelf"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsImage}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardDeleteButton" TargetType="Button" BasedOn="{StaticResource CardDeleteButton}">
            <Setter Property="ToolTip" Value="Delete from Clipboard"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Trigger" Width="32" HorizontalAlignment="Left"
                Background="#01000000" ToolTip="Edge Shelf">
            <Border Width="6" HorizontalAlignment="Left" Background="#997A8494"
                    CornerRadius="0,4,4,0"/>
        </Border>
        <Grid x:Name="PanelSurface" Visibility="Collapsed">
        <Border x:Name="Panel" Margin="0,20,0,20"
                Background="#F21B2029" CornerRadius="0,20,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#FF161B23">
                    <StackPanel Margin="8,20,8,0">
                        <Button x:Name="ShelfButton" Tag="Shelf" ToolTip="Shelf" Click="Section_Click" Style="{StaticResource NavButton}">
                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavIconStroke}" Data="M3 4 H15 V16 H3 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M7 8 H21 V20 H7 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M9 17 L13 13 L16 16 L18 14 L21 17"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M11 11 A1 1 0 1 1 9 11 A1 1 0 1 1 11 11"/>
                            </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="ClipboardButton" Tag="Clipboard" ToolTip="Clipboard" Click="Section_Click" Style="{StaticResource NavButton}">
                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavIconStroke}" Data="M7 5 H17 V21 H7 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M9 3 H15 V7 H9 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M10 11 H14"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M10 14 H14"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M10 17 H14"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M5 7 H7 V19 H5 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M17 7 H19 V19 H17"/>
                            </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="SnippetsButton" Tag="Snippets" ToolTip="Snippets" Click="Section_Click" Style="{StaticResource NavButton}">
                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavIconStroke}" Data="M6 17 L5 21 L9 20 L20 9 L17 6 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M4 22 H20"/>
                            </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="CalendarButton" Tag="Calendar" ToolTip="Calendar" Click="Section_Click" Style="{StaticResource NavButton}">
                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavIconStroke}" Data="M4 6 H20 V21 H4 Z"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M4 10 H20"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M8 3 V7"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M16 3 V7"/>
                                <Path Style="{StaticResource NavIconStroke}" Data="M12 13 L13.2 15.4 L16 15.8 L14 17.7 L14.5 20.5 L12 19.2 L9.5 20.5 L10 17.7 L8 15.8 L10.8 15.4 Z"/>
                            </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>
                <Grid Grid.Column="1" Margin="22,22,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SectionTitle" Foreground="#FFF2F4F7" FontSize="17" FontWeight="SemiBold"/>
                        <Button x:Name="ClipboardClearButton" Content="Clear" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
                                Background="Transparent" BorderThickness="0" Foreground="#FF9CACBD"
                                FontSize="11" Cursor="Hand" Click="ClipboardClear_Click"/>
                    </Grid>
                    <Grid x:Name="ShelfView" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ShelfEmpty" Text="Drop files or images here"
                                   Foreground="#FF9EABB9" FontSize="14" TextAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ListBox x:Name="ShelfList" Margin="0,0,-24,0" Background="Transparent" BorderThickness="0"
                                 Foreground="#FFF2F4F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemContainerStyle="{StaticResource CardListItem}"
                                 PreviewMouseLeftButtonDown="ShelfList_MouseDown"
                                 PreviewMouseMove="ShelfList_MouseMove"
                                 MouseDoubleClick="ShelfList_DoubleClick"
                                 PreviewMouseRightButtonUp="ShelfList_RightClick">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="9">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardSurface}">
                                                <Setter Property="Height" Value="62"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter Property="Height" Value="102"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FF35404D" CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Width" Value="42"/>
                                                        <Setter Property="Height" Value="42"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                <Setter Property="Width" Value="84"/>
                                                                <Setter Property="Height" Value="84"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="#FFB8CBE0" FontSize="22"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Preview}" Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#FF93A0B0" FontSize="11" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource ShelfDeleteButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ShelfDelete_Click">
                                                <Viewbox Width="15" Height="15" Stretch="Uniform">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource NavIconStroke}" Data="M7 7 H17 V21 H7 Z"/>
                                                        <Path Style="{StaticResource NavIconStroke}" Data="M4 7 H20"/>
                                                        <Path Style="{StaticResource NavIconStroke}" Data="M9 4 H15 V7 H9 Z"/>
                                                        <Path Style="{StaticResource NavIconStroke}" Data="M10 11 V17"/>
                                                        <Path Style="{StaticResource NavIconStroke}" Data="M14 11 V17"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid x:Name="ClipboardView" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="ClipboardEmpty" Text="Clipboard history is empty"
                                       Foreground="#FF9EABB9" FontSize="14" TextAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ListBox x:Name="ClipboardList" Margin="0,0,-24,0" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFF2F4F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemContainerStyle="{StaticResource CardListItem}"
                                     PreviewMouseLeftButtonDown="ClipboardList_MouseDown"
                                     PreviewMouseMove="ClipboardList_MouseMove"
                                     PreviewMouseLeftButtonUp="ClipboardList_Click"
                                     PreviewMouseRightButtonUp="ClipboardList_RightClick">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardSurface}" Padding="9" Height="70">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#FF35404D" CornerRadius="5" Width="42" Height="42">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Glyph}" Foreground="#FFB8CBE0" FontSize="22"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ClipboardKind.Text}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ClipboardKind.Url}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                                                            <Viewbox.Style>
                                                                <Style TargetType="Viewbox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ClipboardKind.Text}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Viewbox.Style>
                                                            <Canvas Width="24" Height="24">
                                                                <Path Style="{StaticResource ClipboardIconStroke}" Data="M4 6 H20 V18 H4 Z"/>
                                                                <Path Style="{StaticResource ClipboardIconStroke}" Data="M9 9 V15"/>
                                                                <Path Style="{StaticResource ClipboardIconStroke}" Data="M7 9 H11 M7 15 H11"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                                                            <Viewbox.Style>
                                                                <Style TargetType="Viewbox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ClipboardKind.Url}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Viewbox.Style>
                                                            <Canvas Width="24" Height="24">
                                                                <Path Style="{StaticResource ClipboardIconStroke}" Data="M10 8 H8 A4 4 0 0 0 8 16 H10"/>
                                                                <Path Style="{StaticResource ClipboardIconStroke}" Data="M14 8 H16 A4 4 0 0 1 16 16 H14 M9 12 H15"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Image Source="{Binding Preview}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="#FF93A0B0" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="★" Foreground="#FFD8B66B" FontSize="12"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Pinned}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="2" Style="{StaticResource ClipboardDeleteButton}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Click="ClipboardDelete_Click">
                                                    <Viewbox Width="15" Height="15" Stretch="Uniform">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Style="{StaticResource NavIconStroke}" Data="M7 7 H17 V21 H7 Z"/>
                                                            <Path Style="{StaticResource NavIconStroke}" Data="M4 7 H20"/>
                                                            <Path Style="{StaticResource NavIconStroke}" Data="M9 4 H15 V7 H9 Z"/>
                                                            <Path Style="{StaticResource NavIconStroke}" Data="M10 11 V17"/>
                                                            <Path Style="{StaticResource NavIconStroke}" Data="M14 11 V17"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    <Grid x:Name="SnippetsView" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed"
                          LostKeyboardFocus="TextInput_LostFocus">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SnippetsSearch" Height="32" Padding="9,5" FontSize="12"
                                 Background="#FF29323D" Foreground="#FFF2F4F7"
                                 TextChanged="SnippetsSearch_TextChanged"
                                 ToolTip="Search snippet title, value, or category"/>
                        <Button Grid.Row="1" Content="+ New snippet" HorizontalAlignment="Right"
                                Margin="0,10,0,12" Padding="0" Background="Transparent" BorderThickness="0"
                                Foreground="#FF9EC3E3" FontSize="12" Cursor="Hand"
                                Click="SnippetNew_Click"/>
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="SnippetsEmpty" Text="No snippets yet"
                                       Foreground="#FF9EABB9" FontSize="14" TextAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ListBox x:Name="SnippetsList" Margin="0,0,-24,0" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFF2F4F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemContainerStyle="{StaticResource CardListItem}"
                                     PreviewMouseLeftButtonUp="SnippetsList_Click"
                                     PreviewMouseRightButtonUp="SnippetsList_RightClick">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardSurface}" Padding="10" Height="66">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           FontSize="13" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#FF93A0B0" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Grid x:Name="SnippetForm" Grid.RowSpan="3" Visibility="Collapsed" Background="#FF1B2029">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SnippetFormTitle" Text="New snippet" Foreground="#FFF2F4F7"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <TextBlock Text="Title" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox x:Name="SnippetTitle" Height="32" Padding="8,5" FontSize="12"
                                         Background="#FF29323D" Foreground="#FFF2F4F7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                <TextBlock Text="Value" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox x:Name="SnippetValue" Height="136" Padding="8,7" FontSize="12"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="#FF29323D" Foreground="#FFF2F4F7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Category (optional)" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                                <TextBox x:Name="SnippetCategory" Height="32" Padding="8,5" FontSize="12"
                                         Background="#FF29323D" Foreground="#FFF2F4F7"/>
                            </StackPanel>
                            <TextBlock x:Name="SnippetValidation" Grid.Row="4" Foreground="#FFFF9F9F"
                                       FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Width="72" Height="32" Margin="0,0,8,0"
                                        Background="#FF303B4B" Foreground="#FFF2F4F7" BorderThickness="0"
                                        Click="SnippetCancel_Click"/>
                                <Button Content="Save" Width="72" Height="32"
                                        Background="#FF567DA3" Foreground="White" BorderThickness="0"
                                        Click="SnippetSave_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CalendarView" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed"
                          LostKeyboardFocus="TextInput_LostFocus">
                        <StackPanel x:Name="CalendarSetup" VerticalAlignment="Center">
                            <TextBlock Text="Connect Google Calendar with its private iCal link."
                                       Foreground="#FFC0CAD6" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <TextBlock Text="Secret address in iCal format" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="CalendarIcalUrl" Height="32" Padding="8,5" FontSize="11"
                                     Background="#FF29323D" Foreground="#FFF2F4F7"/>
                            <Button Content="Where to find the private link" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                                    Foreground="#FF9EC3E3" FontSize="11" Cursor="Hand"
                                    Click="CalendarIcalHelp_Click"/>
                            <Button x:Name="CalendarIcalConnectButton" Content="Connect with iCal link"
                                    Height="34" Margin="0,12,0,0" Background="#FF567DA3" Foreground="White"
                                    BorderThickness="0" Click="CalendarIcalConnect_Click"/>
                            <TextBlock Text="Or use Google OAuth" Foreground="#FF93A0B0" FontSize="11"
                                       Margin="0,24,0,8"/>
                            <TextBlock Text="Desktop OAuth Client ID" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="CalendarClientId" Height="32" Padding="8,5" FontSize="11"
                                     Background="#FF29323D" Foreground="#FFF2F4F7"/>
                            <Button Content="Get Client ID in Google Cloud" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                                    Foreground="#FF9EC3E3" FontSize="11" Cursor="Hand"
                                    Click="CalendarHelp_Click"/>
                            <Button x:Name="CalendarConnectButton" Content="Connect Google Calendar"
                                    Height="34" Margin="0,12,0,0" Background="#FF567DA3" Foreground="White"
                                    BorderThickness="0" Click="CalendarConnect_Click"/>
                            <TextBlock x:Name="CalendarConnectStatus" Foreground="#FFFFB6A6" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                        <Grid x:Name="CalendarConnected" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Refresh" Background="Transparent" Foreground="#FF9EC3E3"
                                        BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"
                                        Click="CalendarRefresh_Click"/>
                                <Button Content="Disconnect" Background="Transparent" Foreground="#FF9CACBD"
                                        BorderThickness="0" Cursor="Hand" Click="CalendarDisconnect_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CalendarStatus" Grid.Row="1" Foreground="#FF93A0B0" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <Grid Grid.Row="2">
                                <TextBlock x:Name="CalendarEmpty" Text="No more meetings today."
                                           Foreground="#FF9EABB9" FontSize="14" TextAlignment="Center"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ListBox x:Name="CalendarList" Margin="0,0,-24,0" Background="Transparent" BorderThickness="0"
                                         Foreground="#FFF2F4F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemContainerStyle="{StaticResource CardListItem}">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardSurface}" Padding="10" MinHeight="82">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="54"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding TimeRange}" Foreground="#FFB8C4D0"
                                                               FontSize="11" Margin="0,5,0,0"/>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding RelativeTime}" Foreground="#FF93A0B0" FontSize="11"/>
                                                        <TextBlock Text="  ·  " Foreground="#FF93A0B0" FontSize="11"/>
                                                        <TextBlock Text="{Binding ProviderLabel}" Foreground="#FF93A0B0" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Grid.RowSpan="3" Content="Join" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Width="48" Height="28" Margin="0,0,0,0"
                                                            Background="#FF567DA3" Foreground="White" BorderThickness="0"
                                                            Click="CalendarJoin_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanJoin}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ScrollViewer x:Name="SettingsView" Grid.Row="1" Margin="0,18,0,0"
                                  Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  LostKeyboardFocus="TextInput_LostFocus">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="General" Foreground="#FFF2F4F7" FontWeight="SemiBold" FontSize="13"/>
                            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                                      Foreground="#FFB8C4D0" Margin="0,11,0,12"/>
                            <TextBlock Text="Global shortcut" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ShortcutChoice" Height="30" Background="#FF29323D" Foreground="#FF1B2029">
                                <ComboBoxItem Content="Ctrl+Shift+Space"/>
                                <ComboBoxItem Content="Ctrl+Alt+Space"/>
                                <ComboBoxItem Content="Ctrl+Shift+S"/>
                                <ComboBoxItem Content="Ctrl+Alt+S"/>
                            </ComboBox>
                            <TextBlock Text="Panel" Foreground="#FFF2F4F7" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,10"/>
                            <TextBlock Text="Hover delay" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                            <ComboBox x:Name="HoverDelayChoice" Height="30" Background="#FF29323D" Foreground="#FF1B2029">
                                <ComboBoxItem Content="150 ms" Tag="150"/>
                                <ComboBoxItem Content="200 ms" Tag="200"/>
                                <ComboBoxItem Content="250 ms" Tag="250"/>
                                <ComboBoxItem Content="300 ms" Tag="300"/>
                            </ComboBox>
                            <TextBlock Text="Close delay" Foreground="#FFB8C4D0" FontSize="11" Margin="12,10,0,5"/>
                            <ComboBox x:Name="CloseDelayChoice" Height="30" Background="#FF29323D" Foreground="#FF1B2029">
                                <ComboBoxItem Content="400 ms" Tag="400"/>
                                <ComboBoxItem Content="550 ms" Tag="550"/>
                                <ComboBoxItem Content="700 ms" Tag="700"/>
                                <ComboBoxItem Content="1000 ms" Tag="1000"/>
                            </ComboBox>
                            <TextBlock Text="Shelf" Foreground="#FFF2F4F7" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8"/>
                            <CheckBox x:Name="AutoAddImagesCheck" Content="Auto-add copied images to Shelf"
                                      Foreground="#FFB8C4D0"/>
                            <TextBlock Text="Clipboard" Foreground="#FFF2F4F7" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8"/>
                            <CheckBox x:Name="ClipboardEnabledCheck" Content="Enable clipboard history"
                                      Foreground="#FFB8C4D0" Margin="0,0,0,10"/>
                            <TextBlock Text="History limit (10–500)" Foreground="#FFB8C4D0" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="HistoryLimitText" Height="30" Padding="8,5" FontSize="12"
                                     Background="#FF29323D" Foreground="#FFF2F4F7"/>
                            <TextBlock x:Name="SettingsStatus" Foreground="#FFFFB6A6" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Button Content="Save settings" Height="32" Margin="0,14,0,8"
                                    Background="#FF567DA3" Foreground="White" BorderThickness="0"
                                    Click="SettingsSave_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="ShortcutHint" Grid.Row="2" Text="Ctrl+Shift+Space to toggle"
                               Foreground="#FF788493" FontSize="11"/>
                </Grid>
            </Grid>
        </Border>
        <Path Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
              Data="M0,0 C0,11 9,20 20,20 L0,20 Z" Fill="#FF161B23" IsHitTestVisible="False"/>
        <Path Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Data="M0,0 L20,0 C9,0 0,9 0,20 Z" Fill="#FF161B23" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
